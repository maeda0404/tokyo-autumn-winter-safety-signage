# =========================================================
# 共通処理
# =========================================================

def fetch_bytes(url):
    """
    URLからデータを取得します。
    """

    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": (
                "Mozilla/5.0 "
                "Tokyo-Autumn-Winter-Safety-Signage/1.0"
            )
        }
    )

    with urllib.request.urlopen(
        request,
        timeout=30
    ) as response:

        return response.read()


def fetch_text(url):
    """
    URLからHTMLやテキストを取得します。
    """

    raw_data = fetch_bytes(url)

    return raw_data.decode(
        "utf-8",
        errors="replace"
    )


def fetch_json(url):
    """
    URLからJSONを取得します。
    """

    raw_data = fetch_bytes(url)

    return json.loads(
        raw_data.decode("utf-8")
    )


def html_to_text(html):
    """
    HTMLからscript、style、タグを除去します。
    """

    text = re.sub(
        r"<script[\s\S]*?</script>",
        " ",
        html,
        flags=re.IGNORECASE
    )

    text = re.sub(
        r"<style[\s\S]*?</style>",
        " ",
        text,
        flags=re.IGNORECASE
    )

    text = re.sub(
        r"<[^>]+>",
        " ",
        text
    )

    text = unescape(text)

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


def load_previous_status():
    """
    前回のstatus.jsonを読み込みます。

    外部サイトの取得に失敗した場合は、
    前回の正常値を残すために使用します。
    """

    if not STATUS_FILE.exists():

        return {
            "influenza": {},
            "weather": {}
        }

    try:

        return json.loads(
            STATUS_FILE.read_text(
                encoding="utf-8"
            )
        )

    except Exception as error:

        print(
            "前回データ読込エラー:",
            error
        )

        return {
            "influenza": {},
            "weather": {}
        }


# =========================================================
# 気象庁データ
# =========================================================

def get_active_warning_names():
    """
    東京都の警報・注意報名を取得します。

    「解除」または「発表警報・注意報はなし」は
    有効な注意報として扱いません。
    """

    warning_data = fetch_json(
        WARNING_URL
    )

    warning_names = []

    area_types = warning_data.get(
        "areaTypes",
        []
    )

    for area_type in area_types:

        areas = area_type.get(
            "areas",
            []
        )

        for area in areas:

            warnings = area.get(
                "warnings",
                []
            )

            for warning in warnings:

                status = str(
                    warning.get(
                        "status",
                        ""
                    )
                )

                name = str(
                    warning.get(
                        "name",
                        ""
                    )
                )

                if not name:
                    continue

                if "解除" in status:
                    continue

                if "なし" in status:
                    continue

                warning_names.append(
                    name
                )

    return warning_names


def get_minimum_temperature():
    """
    気象庁の東京都予報から、
    東京地点の予想最低気温を取得します。
    """

    forecast_data = fetch_json(
        FORECAST_URL
    )

    temperatures = []

    for report in forecast_data:

        time_series_list = report.get(
            "timeSeries",
            []
        )

        for time_series in time_series_list:

            areas = time_series.get(
                "areas",
                []
            )

            for area_data in areas:

                area = area_data.get(
                    "area",
                    {}
                )

                area_code = str(
                    area.get(
                        "code",
                        ""
                    )
                )

                if area_code != TOKYO_POINT_CODE:
                    continue

                temperature_values = area_data.get(
                    "temps",
                    []
                )

                for value in temperature_values:

                    try:

                        temperatures.append(
                            float(value)
                        )

                    except (
                        TypeError,
                        ValueError
                    ):

                        continue

    if not temperatures:
        return None

    return min(temperatures)


