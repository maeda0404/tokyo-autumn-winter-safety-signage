def determine_flu_level(per_sentinel):
    """
    定点当たり患者報告数を基準に、
    画面表示用のレベルを判定します。
    """

    if per_sentinel is None:
        return "確認中"

    if per_sentinel >= 30:
        return "警報レベル"

    if per_sentinel >= 10:
        return "注意報レベル"

    if per_sentinel >= 1:
        return "流行中"

    return "非流行"


def find_latest_flu_press_url(top_html):
    """
    東京都感染症情報センターのページから、
    一番新しい東京都の報道発表URLを取得します。

    ページ全体にある過去の「警報」という文字ではなく、
    一番上に掲載された報道発表だけを対象にします。
    """

    patterns = [
        (
            r'href=["\']'
            r'([^"\']*metro\.tokyo\.lg\.jp'
            r'/information/press/'
            r'[^"\']+)'
            r'["\']'
        ),
        (
            r'href=["\']'
            r'([^"\']+)'
            r'["\'][^>]*>'
            r'[^<]*(?:東京都内|都内)'
            r'[^<]*インフルエンザ'
        )
    ]

    found_urls = []

    for pattern in patterns:

        matches = re.findall(
            pattern,
            top_html,
            flags=re.IGNORECASE
        )

        for match in matches:

            complete_url = urljoin(
                FLU_TOP_URL,
                match
            )

            if complete_url not in found_urls:

                found_urls.append(
                    complete_url
                )

    if not found_urls:

        raise ValueError(
            "東京都の最新報道発表URLを取得できません"
        )

    return found_urls[0]


def extract_flu_value(press_text):
    """
    東京都の報道発表本文から、
    定点当たり患者報告数を取得します。

    例：
    インフルエンザ患者報告数は1.49
    """

    patterns = [
        (
            r"インフルエンザ"
            r"(?:患者)?報告数"
            r"は\s*"
            r"([0-9]+(?:\.[0-9]+)?)"
        ),
        (
            r"定点(?:医療機関)?"
            r"(?:当たり|からの)"
            r".{0,80}?"
            r"報告数"
            r"(?:は|が|：|:)?\s*"
            r"([0-9]+(?:\.[0-9]+)?)"
        )
    ]

    for pattern in patterns:

        match = re.search(
            pattern,
            press_text
        )

        if match:

            return float(
                match.group(1)
            )

    return None


def extract_week_information(press_text):
    """
    報道発表本文から、
    対象週と対象期間を取得します。

    例：
    第34週（8月17日から8月23日まで）
    """

    patterns = [
        (
            r"第\s*(\d+)\s*週"
            r"\s*[（(]"
            r"\s*(\d+)\s*月\s*(\d+)\s*日"
            r"\s*から\s*"
            r"(\d+)\s*月\s*(\d+)\s*日"
            r"\s*まで\s*[）)]"
        ),
        (
            r"第\s*(\d+)\s*週"
            r".{0,20}?"
            r"(\d+)\s*月\s*(\d+)\s*日"
            r".{0,10}?"
            r"(\d+)\s*月\s*(\d+)\s*日"
        )
    ]

    for pattern in patterns:

        match = re.search(
            pattern,
            press_text
        )

        if not match:
            continue

        week_number = int(
            match.group(1)
        )

        start_month = int(
            match.group(2)
        )

        start_day = int(
            match.group(3)
        )

        end_month = int(
            match.group(4)
        )

        end_day = int(
            match.group(5)
        )

        return {
            "week": f"第{week_number}週",
            "period": (
                f"{start_month}月{start_day}日"
                f"～"
                f"{end_month}月{end_day}日"
            )
        }

    return {
        "week": "最新発表",
        "period": "東京都"
    }


